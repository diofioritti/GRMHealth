### Queries SQL
```python
# queries/metricas_principais.py

QUERY_TOTAL_ATENDIMENTOS = """
    -- Total de atendimentos realizados
    SELECT 
        COUNT(DISTINCT protocol_id) AS total_atendimentos
    FROM protocol_status_history
    WHERE created_date >= %s 
      AND created_date <= %s
"""

def get_total_atendimentos(data_inicio, data_fim):
    """
    Retorna total de atendimentos no período.
    
    Args:
        data_inicio: Data inicial (datetime)
        data_fim: Data final (datetime)
    
    Returns:
        int: Total de atendimentos
    """
    try:
        conn = get_connection()
        df = pd.read_sql_query(
            QUERY_TOTAL_ATENDIMENTOS, 
            conn, 
            params=(data_inicio, data_fim)
        )
        conn.close()
        return df['total_atendimentos'].iloc[0]
    except Exception as e:
        print(f"Erro ao buscar total de atendimentos: {e}")
        return 0
```

