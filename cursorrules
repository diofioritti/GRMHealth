from dash import Input, Output, callback
from queries.metricas_principais import get_total_atendimentos
from queries.analise_tempo import get_dados_completos

@callback(
    Output('dados-store', 'data'),
    Input('btn-atualizar', 'n_clicks'),
    State('filtro-data-inicio', 'date'),
    State('filtro-data-fim', 'date'),
    prevent_initial_call=False
)
def atualizar_dados(n_clicks, data_inicio, data_fim):
    """
    Atualiza os dados quando o botão é clicado.
    Armazena no dcc.Store para ser usado por outros callbacks.
    """
    if data_inicio is None or data_fim is None:
        from datetime import datetime, timedelta
        data_fim = datetime.now()
        data_inicio = data_fim - timedelta(days=30)
    
    # Buscar todos os dados necessários
    dados = {
        'data_inicio': data_inicio,
        'data_fim': data_fim,
        'total_atendimentos': get_total_atendimentos(data_inicio, data_fim),
        # Adicionar outras queries aqui
    }
    
    return dados

@callback(
    Output('card-total-atendimentos', 'children'),
    Input('dados-store', 'data')
)
def atualizar_card_total(dados):
    """Atualiza card de total de atendimentos"""
    if dados is None:
        return "0"
    return f"{dados['total_atendimentos']:,}".replace(",", ".")
