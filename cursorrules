## 🔧 TRATAMENTO DE ERROS EM CALLBACKS
```python
from dash import Input, Output, callback, html
import dash_bootstrap_components as dbc

@callback(
    Output('grafico-tempo', 'figure'),
    Output('error-alert', 'children'),
    Output('error-alert', 'is_open'),
    Input('dados-store', 'data')
)
def atualizar_grafico(dados):
    """Atualiza gráfico com tratamento de erro"""
    try:
        if dados is None or len(dados) == 0:
            return {}, "Nenhum dado disponível", True
        
        # Processar dados e criar gráfico
        fig = criar_grafico(dados)
        return fig, "", False
        
    except Exception as e:
        erro_msg = f"❌ Erro ao criar gráfico: {str(e)}"
        print(erro_msg)
        return {}, erro_msg, True

# No layout, adicionar:
dbc.Alert(id='error-alert', color='danger', is_open=False, dismissable=True)
```

## 📊 FORMATAÇÃO DE DADOS
```python
# utils/formatters.py

def formatar_tempo_hms(segundos: int) -> str:
    """Converte segundos para formato HH:MM:SS"""
    if segundos is None or segundos < 0:
        return "00:00:00"
    horas = segundos // 3600
    minutos = (segundos % 3600) // 60
    segs = segundos % 60
    return f"{horas:02d}:{minutos:02d}:{segs:02d}"

def formatar_percentual(valor: float) -> str:
    """Formata número como percentual"""
    if valor is None:
        return "0.0%"
    return f"{valor:.1f}%"

def formatar_numero(valor: int) -> str:
    """Formata número com separador de milhar (padrão BR)"""
    if valor is None:
        return "0"
    return f"{valor:,}".replace(",", ".")

def formatar_data_br(data: str) -> str:
    """Converte data ISO para formato brasileiro"""
    from datetime import datetime
    dt = datetime.fromisoformat(data)
    return dt.strftime("%d/%m/%Y")
```

