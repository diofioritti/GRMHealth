# Hugging Face / Modelo
MODEL_ID=google/medgemma-4b-it
HF_TOKEN=

# Execução do modelo
# DEVICE: auto | cpu | cuda
DEVICE=auto
USE_QUANTIZATION=false
MAX_NEW_TOKENS=512
TEMPERATURE=0.2
TOP_P=0.9

# API
API_HOST=127.0.0.1
API_PORT=8000

# CORS (separado por vírgula)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Rate limit (slowapi)
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO
LOG_DIR=./data/logs

